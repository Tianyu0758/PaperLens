APP_ENV=development
RAG_HOST=127.0.0.1
RAG_PORT=18081
GROBID_URL=http://127.0.0.1:8070
EMBEDDING_URL=http://127.0.0.1:8003
# Embedding API 中的模型名，与服务启动时的 --served-model-name 保持一致。
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# RAG 只下载 tokenizer；可填 Hugging Face 模型 ID 或本地目录，不需要模型权重或 GPU。
EMBEDDING_TOKENIZER=Qwen/Qwen3-Embedding-0.6B
RERANKER_URL=http://127.0.0.1:8004
RERANK_TOP_K=5
# 默认连接 compose 的本地 Qdrant；使用远程/Cloud 时改地址并填写密钥。
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
HYDE_MODEL=replace-with-your-model-name
GENERATION_MODEL=replace-with-your-model-name
BM25_INDEX_PATH=./data/bm25_index
SQLITE_PATH=./data/papers.db
LOG_PATH=./data/logs
UPLOAD_PATH=./uploads
MAX_UPLOAD_MB=50
HTML_QDRANT_COLLECTION=paperlens_chunks
# 仅在本地启动 GPU 模型服务时使用；路径为空则从 Hugging Face 模型 ID 加载权重。
EMBEDDING_MODEL_PATH=
EMBEDDING_HOST=127.0.0.1
EMBEDDING_PORT=8003
EMBEDDING_GPU_MEMORY_UTILIZATION=0.30
EMBEDDING_MAX_MODEL_LEN=4096
EMBEDDING_DTYPE=half
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_HOST=127.0.0.1
RERANKER_PORT=8004
RERANKER_GPU_MEMORY_UTILIZATION=0.45
RERANKER_MAX_MODEL_LEN=2048
RERANKER_DTYPE=half
