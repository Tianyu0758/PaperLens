AGENT_HOST=127.0.0.1
AGENT_PORT=18091
RAG_BASE_URL=http://127.0.0.1:18081
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=replace-with-your-model-name
AGENT_DATA_DIR=./data
AGENT_RUN_TIMEOUT_SECONDS=900
AGENT_CONTEXT_MAX_TOKENS=16000
AGENT_RECURSION_LIMIT=48
AGENT_MAX_UPLOAD_MB=50
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY=512m
SANDBOX_CPUS=0.5
DOCKER_BIN=docker
# docker compose 使用以下配置；修改端口后同步更新 rag_service/.env 中的服务地址。
GROBID_IMAGE=lfoppiano/grobid:0.8.0
GROBID_PORT=8070
QDRANT_IMAGE=qdrant/qdrant:v1.19.0
QDRANT_PORT=6333
